# All EXPO_PUBLIC values are visible in the shipped bundle.
# Leave both blank to inspect the login setup screen without a backend.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# CAPTCHA is optional until configured in Supabase. Site key is public; secret stays in Supabase.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# HTTPS origin for the native CAPTCHA WebView, e.g. https://closet.itsmesungjun.chatgpt.site
EXPO_PUBLIC_WEB_ORIGIN=
