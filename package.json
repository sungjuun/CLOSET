{
  "name": "closet",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.23.0 <23"
  },
  "scripts": {
    "postinstall": "node scripts/patch-metro-watcher.cjs",
    "start": "expo start",
    "web": "expo start --web",
    "web:measure": "node scripts/measure-web.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "export:web": "expo export --platform web",
    "export:native": "expo export --platform android --platform ios",
    "build": "node scripts/build-hosted-web.mjs",
    "backup:local": "node scripts/backup-local-project.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:types": "node scripts/generate-db-types.mjs",
    "db:migrate": "supabase migration up --local",
    "db:test": "node --test --test-concurrency=1 tests/integration/supabase.test.mjs && vitest run --config vitest.integration.config.mts",
    "env:local": "node scripts/configure-local-env.mjs",
    "env:cloud": "node scripts/configure-cloud-env.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.12",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "supabase": "^2.122.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
