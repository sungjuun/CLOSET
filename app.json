{
  "expo": {
    "name": "CLOSET.",
    "slug": "closet",
    "version": "0.1.0",
    "scheme": "closet",
    "userInterfaceStyle": "light",
    "orientation": "default",
    "platforms": ["ios", "android", "web"],
    "ios": { "supportsTablet": true },
    "web": { "bundler": "metro", "output": "single", "name": "CLOSET.", "favicon": "./assets/favicon.png" },
    "plugins": ["expo-router", "expo-secure-store", ["expo-image-picker", { "photosPermission": "옷장에 등록할 사진을 선택하기 위해 사진 접근 권한을 사용합니다.", "cameraPermission": "옷 사진을 촬영하기 위해 카메라 권한을 사용합니다.", "microphonePermission": false }]],
    "experiments": { "typedRoutes": true }
  }
}
